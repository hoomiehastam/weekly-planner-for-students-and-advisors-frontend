# ============================================================
#  تنظیمات محیطی فرانت‌اند — پلتفرم برنامه‌ریزی مطالعاتی کنکور
#  ⚠️  هر متغیری که با پیشوند VITE_ شروع شود، داخل باندل جاسازی می‌شود
#      و در دسترس کاربر است. هرگز کلید یا رمز حساس را اینجا نگذار.
#      فایل توسط Vite هم در حالت dev و هم در زمان build خوانده می‌شود.
# ============================================================


# ------------------------------------------------------------
#  آدرس پایه‌ی بک‌اند (تنها متغیر مورد نیاز فرانت)
#  استفاده‌شده در: src/api/client.js
#  این مقدار پیشوند همه‌ی درخواست‌هایی است که به /api/... زده می‌شود.
# ------------------------------------------------------------

# --- حالت توسعه‌ی لوکال: آدرس مستقیم بک‌اند روی همین سیستم ---
# پورت ۳۰۰۱ با PORT در backend/.env و پروکسی vite.config.js هماهنگ است.
# چون هر دو روی http://localhost هستند، کوکی SameSite=Lax ارسال می‌شود؛
# مجاز بودن درخواست‌های cross-origin هم با CORS_ORIGIN در backend/.env کنترل می‌شود.
#VITE_API_BASE_URL="http://localhost:3001"

# --- حالت توسعه با پروکسی Vite (درخواست‌ها same-origin می‌شوند) ---
# مقدار را خالی بگذار تا BASE_URL برابر '' شود و درخواست‌ها
# از همان origin فرانت (پورت ۵۱۷۳) به /api بروند و پروکسی آن‌ها را
# به بک‌اند لوکال بفرستد. مزیت: بدون هیچ درگیری CORS یا کوکی.
# VITE_API_BASE_URL=""

# --- حالت تولید (Render) ---
# آدرس بک‌اند دیپلوی‌شده:
VITE_API_BASE_URL="https://api.daneshamoozino.ir"

# --- دامنه‌ی فرانت دیپلوی‌شده (برای یادآوری؛ فرانت متغیر دیگری نمی‌خواند) ---
# در محیط تولید، همین آدرس باید در CORS_ORIGIN بک‌اند هم باشد.
# https://weekly-planner-for-students-and-advisors.onrender.com


# ------------------------------------------------------------
#  سایر تنظیمات Vite که می‌توانی اضافه کنی (اختیاری)
#  پیش‌فرض‌های فعلی پروژه: dev روی پورت ۵۱۷۳ با پروکسی /api
# ------------------------------------------------------------

# پورت سرور توسعه (vite.config.js مقدار ۵۱۷۳ را set کرده است)
# VITE_PORT=5173

# مسیر build (vite.config.js پیش‌فرض dist است)
# VITE_BUILD_OUT_DIR=dist
