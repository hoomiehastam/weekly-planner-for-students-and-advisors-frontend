# --- آدرس پایه‌ی بک‌اند — src/api/client.js ---
# پیشوند همه‌ی درخواست‌های /api/... است.
# توسعه‌ی لوکال (آدرس مستقیم):
VITE_API_BASE_URL="https://api.daneshamoozino.ir"

